# Caddy obtains and renews a free Let's Encrypt HTTPS certificate for the domain automatically.
# HTTPS is required: phones only allow GPS and camera on secure pages, and admin cookies are Secure.
{$FLOODPULSE_DOMAIN} {
	encode zstd gzip
	header Strict-Transport-Security "max-age=31536000"
	request_body {
		max_size 8MB
	}
	reverse_proxy app:8000
}
