# Copy to deploy/.env (private; never commit it) and fill in. ./setup.sh adds the database
# passwords and FLOODPULSE_ORIGIN automatically.

# Public address of the server, without https://
FLOODPULSE_DOMAIN=floodpulse-smvitm.centralindia.cloudapp.azure.com

# Optional keys (copy the values from your laptop's private .env)
GOOGLE_MAPS_EMBED_API_KEY=
OPENROUTESERVICE_API_KEY=
TELEGRAM_BOT_USERNAME=
TELEGRAM_BOT_TOKEN=
# Keep the JSON inside single quotes, on one line
TELEGRAM_DESTINATIONS=
TELEGRAM_WEBHOOK_SECRET=
