# Explicit backend selection; file is supported for migration/offline operation.
LOCATION_DIRECTORY_BACKEND=postgres
# Supply private deployment-specific URLs through environment/secret management.
# DATABASE_URL=postgresql+psycopg://READ_ONLY_USER:URL_ENCODED_PASSWORD@HOST:PORT/floodpulse_directory
# Maintenance process only; do not pass this variable to the public API process.
# LOCATION_DIRECTORY_ADMIN_URL=postgresql+psycopg://DIRECTORY_OWNER:URL_ENCODED_PASSWORD@HOST:PORT/floodpulse_directory

# Same database, separate restricted shelter-service login. No maintenance URL in API.
# SHELTER_DATABASE_URL=postgresql+psycopg://SHELTER_APP:URL_ENCODED_PASSWORD@HOST:PORT/floodpulse_directory
# Exact browser origin; required for admin requests and CSRF validation.
# SHELTER_PUBLIC_ORIGIN=https://floodpulse.example.org
SHELTER_COOKIE_SECURE=true
SHELTER_DIRECTORY_MODE=live
# For explicit loopback-only local development:
# SHELTER_PUBLIC_ORIGIN=http://127.0.0.1:5173
# SHELTER_COOKIE_SECURE=false
