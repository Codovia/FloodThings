{
  "mcpServers": {
    "chrome-devtools": {
      "command": "npx",
      "args": [
        "-y",
        "chrome-devtools-mcp@1.11.0",
        "--executablePath=./scripts/chrome-for-mcp.sh",
        "--isolated",
        "--viewport=1440x900",
        "--usageStatistics=false",
        "--performanceCrux=false"
      ],
      "env": {
        "CHROME_DEVTOOLS_MCP_NO_UPDATE_CHECKS": "1"
      }
    }
  }
}
