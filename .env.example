# FloodPulse — environment configuration template
# Copy to .env and fill in real values. NEVER commit .env.

# PostgreSQL / PostGIS
POSTGRES_DB=floodpulse
POSTGRES_USER=floodpulse
POSTGRES_PASSWORD=CHANGE_ME

# Backend — SQLAlchemy database URL
DATABASE_URL=postgresql+psycopg2://floodpulse:CHANGE_ME@localhost:5432/floodpulse

# Application environment: development, staging, production
APP_ENV=development
